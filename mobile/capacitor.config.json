{
  "appId":    "com.audiorelay.mobile",
  "appName":  "AudioRelay",
  "webDir":   "dist",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "android": {
    "minSdkVersion":    26,
    "targetSdkVersion": 34,
    "buildOptions": {
      "keystorePath":    "release.keystore",
      "keystoreAlias":   "audiorelay",
      "releaseType":     "APK"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor":    "#0C131E",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#0C131E"
    }
  }
}
